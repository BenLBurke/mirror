# Copy to tp920.env and edit. KEY=VALUE, no spaces around "=".
# Real environment variables override anything in this file.
# This same file is used by systemd (EnvironmentFile=).

# --- Required: your ntfy topic. Pick something long and unguessable;
# anyone who knows the name can read and post to it.
TP920_NTFY_TOPIC=

# --- Optional ntfy settings
#TP920_NTFY_SERVER=https://ntfy.sh
#TP920_NTFY_TOKEN=            # only for access-controlled / self-hosted topics

# --- Device
#TP920_ADDRESS=AA:BB:CC:DD:EE:FF   # blank = scan for a name starting with Thermo/TP
#TP920_NAME_PREFIXES=Thermo,TP
#TP920_PROBE=1                     # probe in the breast (1 or 2)
#TP920_WIRE_UNIT=C                 # raw probe values are Celsius per community notes
#TP920_SEND_ACK=1                  # send 30 00 30 after each frame like the phone app
#TP920_DATA_TIMEOUT_SECONDS=60     # poll, then reconnect, if no frames this long
#TP920_LOG_RAW=0                   # 1 = log every raw frame (debugging)

# --- Alerts
#TP920_THRESHOLDS_F=140,150,160,165
#TP920_THRESHOLD_REARM_F=5         # a threshold re-arms after dropping this far below it
#TP920_STALL_MINUTES=30
#TP920_STALL_MIN_RISE_F=1.0        # rising less than this over the window = flat
#TP920_STALL_MIN_TEMP_F=100        # don't stall-alert while still cold
#TP920_BLIND_MINUTES=5             # no reading this long = urgent alert
#TP920_HEARTBEAT_MINUTES=15        # 0 disables

# --- Logging
#TP920_LOG_INTERVAL_SECONDS=60
#TP920_CSV_PATH=tp920_log.csv
